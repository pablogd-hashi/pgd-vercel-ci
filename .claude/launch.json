{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "infra/local/dev-local.sh",
        "preview"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-local-prod",
      "runtimeExecutable": "bash",
